    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "torrent-stream": "^1.2.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/torrent-stream": "^0.0.9",
    "autoprefixer": "^10.4.21",
